{
  "name": "@barzkit/sdk",
  "version": "0.1.3",
  "type": "module",
  "description": "Self-custody AI agent wallets with passkeys, gasless transactions & programmable permissions (ERC-4337)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "typescript",
    "sdk",
    "web3",
    "ai-agents",
    "defi",
    "trust-wallet",
    "account-abstraction",
    "erc-4337",
    "smart-accounts",
    "barz"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/barzkit/sdk"
  },
  "homepage": "https://github.com/barzkit/sdk#readme",
  "bugs": {
    "url": "https://github.com/barzkit/sdk/issues"
  },
  "dependencies": {
    "permissionless": "^0.3.4",
    "viem": "^2.46.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "viem": ">=2.21.0"
  },
  "overrides": {
    "ox": "^0.12.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
